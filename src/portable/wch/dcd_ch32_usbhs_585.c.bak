 // Stall an endpoint
 void dcd_edpt_stall(uint8_t rhport, uint8_t ep_addr) {
   (void)rhport;
  (void) ep_addr;
  //TODO
   uint8_t const ep_num = tu_edpt_number(ep_addr);
   tusb_dir_t const dir = tu_edpt_dir(ep_addr);
 
   if (dir == TUSB_DIR_OUT) {
     ep_set_out_response(ep_num, EP_RESPONSE_STALL);
   } else {
     ep_set_in_response(ep_num, EP_RESPONSE_STALL);
     //ep_set_tx_length(ep_num, 0);
     USBHS_TX_LEN(ep_num) = 0;
   }
 }
 
 // Clear stall on an endpoint
 void dcd_edpt_clear_stall(uint8_t rhport, uint8_t ep_addr) {
   (void)rhport;
  (void) ep_addr;
   uint8_t const ep_num = tu_edpt_number(ep_addr);
   tusb_dir_t const dir = tu_edpt_dir(ep_addr);
 
   if (dir == TUSB_DIR_OUT) {
     ep_set_out_response(ep_num, EP_RESPONSE_NAK);
   } else {
     ep_set_in_response(ep_num, EP_RESPONSE_NAK);
   }
 }
 
 // Initiate a transfer on an endpoint
 bool dcd_edpt_xfer(uint8_t rhport, uint8_t ep_addr, uint8_t* buffer, uint16_t total_bytes) {
   (void)rhport;
 
   uint8_t const ep_num = tu_edpt_number(ep_addr);
   tusb_dir_t const dir = tu_edpt_dir(ep_addr);
 
   xfer_ctl_t* xfer = &xfer_status[ep_num][dir];
   xfer->buffer = buffer;
   xfer->total_len = total_bytes;
   xfer->queued_len = 0;
   xfer->is_last_packet = false;
 
   xfer_data_packet(ep_num, dir, xfer);
 
   return true;
 }
 


 // Interrupt handler// Interrupt handler
void dcd_int_handler(uint8_t rhport) {
  (void)rhport;
  printf("USB Interrupt\n");
  // Read interrupt flags
  uint8_t int_flag = R8_USB2_INT_FG;
  uint8_t int_status = R8_USB2_INT_ST;
  if (int_flag & USBHS_UDIF_TRANSFER) {
    
    // Transfer complete (IN, OUT, or SETUP)
    //uint8_t token = usb_get_token_type(); // Assume chip provides token (IN/OUT)
    uint8_t ep_dir = (int_status & USBHS_UDIS_EP_DIR) >> 4;
    // 1 = IN 0 = OUT/SETUP
    //uint8_t ep_num = usb_get_endpoint_number(); // Assume chip provides endpoint number
    uint8_t ep_num = int_status & USBHS_UDIS_EP_ID_MASK;
    //tusb_dir_t ep_dir = (token == TOKEN_PID_IN) ? TUSB_DIR_IN : TUSB_DIR_OUT;
    uint8_t ep_addr = tu_edpt_addr(ep_num, ep_dir);
    xfer_ctl_t* xfer = &xfer_status[ep_num][ep_dir];
    /*if (ep_num == 0)
    {
      printf("EP0 xfer completed, dir: %d,  buf=", ep_dir);
        for (int i = 0; i < 16; i++)
        {
          printf("%02X ", ep0_buffer[i]);
        }
        printf("raw buf data end\n");
    }*/
    printf("USB Transfer: dir = %d, ep_num = %d, ep_addr = %02X\n", ep_dir, ep_num, ep_addr);
    if (ep_num == 0 && ep_dir == TUSB_DIR_OUT) {
      // Check for SETUP packet
      bool is_setup = false;
      //uint16_t rx_len = usb_get_rx_length(); // Get received length
      uint16_t rx_len = USBHS_RX_LEN(ep_num);

      // Primary check: Use RB_UEP_R_SETUP_IS bit
      if (R8_U2EP0_RX_CTRL &  USBHS_UEP_R_SETUP_IS) {
        is_setup = true;
        
      }

      if (is_setup) {
        printf("SETUP packet arrived\n");
        // Handle SETUP packet
        ep0_in_toggle = 0; // Reset IN toggle to DATA0
        ep0_out_toggle = 0; // Reset OUT toggle to DATA0
        ep_set_response_and_toggle(0, TUSB_DIR_IN, EP_RESPONSE_NAK);
        ep_set_response_and_toggle(0, TUSB_DIR_OUT, EP_RESPONSE_NAK);
        dcd_event_setup_received(rhport, ep0_buffer, true);

        // Clear RX done flag
        R8_U2EP0_RX_CTRL &= ~USBHS_UEP_R_DONE;
      } else {
        printf("Normal OUT packet arrived\n");
        // Handle OUT transfer (non-SETUP)
        memcpy(&xfer->buffer[xfer->queued_len], ep0_buffer, rx_len);
        xfer->queued_len += rx_len;

        // Check if this is the last packet
        if (rx_len < xfer->max_size || xfer->queued_len == xfer->total_len) {
          xfer->is_last_packet = true;
        }

        if (xfer->is_last_packet) {
          ep_set_response_and_toggle(ep_num, ep_dir, EP_RESPONSE_NAK);
          dcd_event_xfer_complete(rhport, ep_addr, xfer->queued_len, XFER_RESULT_SUCCESS, true);
        } else {
          xfer_data_packet(ep_num, ep_dir, xfer);
        }

        // Clear RX done flag
        R8_U2EP0_RX_CTRL &= ~USBHS_UEP_R_DONE;
      }
    } 
    else if (ep_dir == TUSB_DIR_IN && ep_num == 0) 
    {
      printf("Normal IN packet arrived on ep0\n");
      // IN transfer on EP0
      if (xfer->is_last_packet) {
        ep_set_response_and_toggle(ep_num, ep_dir, EP_RESPONSE_NAK);
        dcd_event_xfer_complete(rhport, ep_addr, xfer->queued_len, XFER_RESULT_SUCCESS, true);
      } else {
        xfer_data_packet(ep_num, ep_dir, xfer);
      }

      // Clear TX done flag (assume R8_U2EP0_TX_CTRL has RB_UEP_T_DONE at bit 7)
      R8_U2EP0_TX_CTRL &= ~(1 << 7);
    }
    if(ep_num != 0) // endpoints other than 0
    {
      printf("Non-0 endpoint interrupt\n");
      // Non-EP0 endpoint handling
      if (xfer->buffer == NULL) 
      {
        // Endpoint not configured, set NAK
        printf("Unexpected non-EP0 interrupt: ep_num=%d, dir=%d\n", ep_num, ep_dir);
        if (ep_dir == TUSB_DIR_OUT) 
        {
          ep_set_out_response(ep_num, EP_RESPONSE_NAK);
          R8_U2EPn_RX_CTRL(ep_num) &= ~USBHS_UEP_R_DONE;
        } else 
        {
          ep_set_response_and_toggle(ep_num, ep_dir, EP_RESPONSE_NAK);
          R8_U2EPn_TX_CTRL(ep_num) &= ~USBHS_UEP_R_DONE;
        }
      } else if (ep_dir == TUSB_DIR_OUT) 
      {
        // Non-EP0 OUT transfer
        uint16_t rx_len = USBHS_RX_LEN(ep_num);
        printf("Non-EP0 OUT: ep_num=%d, rx_len=%u\n", ep_num, rx_len);
        if (rx_len > 0 && xfer->queued_len + rx_len <= xfer->total_len) 
        {
          // Copy data from RX buffer to xfer buffer
          memcpy(&xfer->buffer[xfer->queued_len], (void*)R32_U2EPn_RX_DMA(ep_num), rx_len);
          xfer->queued_len += rx_len;
          // Check if transfer is complete (short packet or full buffer)
          if (rx_len < xfer->max_size || xfer->queued_len == xfer->total_len) 
          {
            xfer->is_last_packet = true;
            ep_set_out_response(ep_num, EP_RESPONSE_NAK);
            dcd_event_xfer_complete(rhport, ep_addr, xfer->queued_len, XFER_RESULT_SUCCESS, true);
          } else 
          {
            ep_set_out_response(ep_num, EP_RESPONSE_ACK);
          }
        } else {
          // Invalid length or buffer overflow, stall
          ep_set_out_response(ep_num, EP_RESPONSE_STALL);
        }
        R8_U2EPn_RX_CTRL(ep_num) &= ~USBHS_UEP_R_DONE;
      } 
      else 
      {
        // Non-EP0 IN transfer
        printf("Non-EP0 IN: ep_num=%d, queued_len=%u\n", ep_num, xfer->queued_len);
        if (xfer->is_last_packet) 
        {
          ep_set_response_and_toggle(ep_num, ep_dir, EP_RESPONSE_NAK);
          dcd_event_xfer_complete(rhport, ep_addr, xfer->queued_len, XFER_RESULT_SUCCESS, true);
        } 
        else 
        {
          // Prepare next packet
          uint16_t len = tu_min16(xfer->total_len - xfer->queued_len, xfer->max_size);
          memcpy((void*)R32_U2EPn_TX_DMA(ep_num), &xfer->buffer[xfer->queued_len], len);
          USBHS_TX_LEN(ep_num) = len;
          xfer->queued_len += len;
          ep_set_response_and_toggle(ep_num, ep_dir, EP_RESPONSE_ACK);
          if (xfer->queued_len == xfer->total_len) 
          {
            xfer->is_last_packet = true;
          }
        }
        R8_U2EPn_TX_CTRL(ep_num) &= ~USBHS_UEP_T_DONE;
      }
    }
    // Clear transfer interrupt flag
    R8_USB2_INT_FG |= USBHS_UDIE_TRANSFER; // Write 1 to clear
  }  
    if (int_flag & USBHS_UDIF_RX_SOF) {
    printf("SOF\n");
    // Start of Frame received
    uint32_t frame_count = (uint32_t)(R16_USB2_FRAME_NO & USBHS_UD_FRAME_NO);// Assume chip provides frame number
    dcd_event_sof(rhport, frame_count, true);

    // Clear SOF interrupt flag
    R8_USB2_INT_FG |= USBHS_UDIF_RX_SOF; // Write 1 to clear
  } else if (int_flag & USBHS_UDIF_SUSPEND) {
    printf("SUSPEND\n");
    // Suspend detected
    dcd_event_t event = {.rhport = rhport, .event_id = DCD_EVENT_SUSPEND};
    dcd_event_handler(&event, true);

    // Clear SUSPEND interrupt flag
    R8_USB2_INT_FG |= USBHS_UDIF_SUSPEND; // Write 1 to clear
  } else if (int_flag & USBHS_UDIF_BUS_RST) {
    printf("RST\n");
    // Bus reset detected
    dcd_event_bus_reset(rhport, TUSB_SPEED_HIGH, true);

    // Reset device address
    //usb_set_device_address(0);
    R8_USB2_DEV_AD = 0;

    // Reset EP0 toggles
    ep0_in_toggle = 0;
    ep0_out_toggle = 0;

    // Set EP0 to ACK for OUT, NAK for IN
    ep_set_out_response( 0, EP_RESPONSE_ACK);
    ep_set_in_response( 0, EP_RESPONSE_NAK);

    // Clear BUS_RESET interrupt flag
    R8_USB2_INT_FG |= USBHS_UDIF_BUS_RST; // Write 1 to clear
  }
}