 void dcd_remote_wakeup(uint8_t rhport) {
   (void)rhport;
   //TODO
   //usb_signal_remote_wakeup();
 }
 
 // Enable/disable SOF interrupts
 void dcd_sof_enable(uint8_t rhport, bool en) {
   (void)rhport;
   if (en) {
     //usb_enable_interrupt(SOF_ACT_EN);
     R8_U2H_INT_EN |= USBHS_UHIE_SOF_ACT;
   } else {
     //usb_disable_interrupt(SOF_ACT_EN);
     R8_U2H_INT_EN &= ~USBHS_UHIE_SOF_ACT;
   }
 }
 
 // Complete Status Stage of SET_ADDRESS request
 void dcd_edpt0_status_complete(uint8_t rhport, tusb_control_request_t const* request) {
   (void)rhport;
 
   if (request->bmRequestType_bit.recipient == TUSB_REQ_RCPT_DEVICE &&
       request->bmRequestType_bit.type == TUSB_REQ_TYPE_STANDARD &&
       request->bRequest == TUSB_REQ_SET_ADDRESS) {
     // Set device address after Status Stage
     DelayUs(50); // likely a hardware issue, a small delay stablized the USB controller, otherwise it will fail a SET_ADDRESS stage
     R8_USB2_DEV_AD = ((uint8_t)request->wValue);
   }
 
   // Reset toggles for next control transfer
   ep0_in_toggle = 0;
   ep0_out_toggle = 0;
 
   // Set EP0 to NAK for both directions
   ep_set_in_response(0, EP_RESPONSE_NAK);
   ep_set_out_response(0, EP_RESPONSE_NAK);
 }
 
 // Open an endpoint (for non-EP0, simplified for EP0)
 bool dcd_edpt_open(uint8_t rhport, tusb_desc_endpoint_t const* desc_edpt) {
   (void)rhport;
   printf("dcd_edpt_open: rhport=%d, ep_num=%d, dir=%d\n", 
    rhport, tu_edpt_number(desc_edpt->bEndpointAddress), tu_edpt_dir(desc_edpt->bEndpointAddress));
   uint8_t const ep_num = tu_edpt_number(desc_edpt->bEndpointAddress);
   tusb_dir_t const dir = tu_edpt_dir(desc_edpt->bEndpointAddress);
 
   TU_ASSERT(ep_num < EP_MAX);
 
   if (ep_num == 0) {
     // EP0 is always open for control transfers
     return true;
   }
   printf("Opening endpoint: ep_num=%d, dir=%d\n", ep_num, dir);
   xfer_ctl_t* xfer = &xfer_status[ep_num][dir];
   xfer->max_size = tu_edpt_packet_size(desc_edpt);
 
   TU_ASSERT(ep_num <= MAX_EP_NUM); // Support EP1–7
  TU_ASSERT(tu_edpt_packet_size(desc_edpt) <= MAX_PACKET_SIZE); // Ensure buffer size is sufficient

  xfer_ctl_t* xfer_local = &xfer_status[ep_num][dir];
  xfer_local->max_size = tu_edpt_packet_size(desc_edpt);
  xfer_local->buffer = (dir == TUSB_DIR_IN) ? ep_in_buffers[ep_num - 1] : ep_out_buffers[ep_num - 1];
  xfer_local->total_len = 0;
  xfer_local->queued_len = 0;
  xfer_local->is_last_packet = false;

  if (dir == TUSB_DIR_OUT) {
    // Configure OUT endpoint for interrupt or bulk transfers
    R32_U2EPn_RX_DMA(ep_num) = (uint32_t)xfer_local->buffer & UEPn_DMA_MASK;
    USBHS_MAX_LEN(ep_num) = xfer_local->max_size & UEPn_MAX_LEN_MASK;
    R8_U2EPn_RX_CTRL(ep_num) = USBHS_UEP_R_TOG_MASK | (0x0 << 0); // Auto-toggle, NAK
    R16_U2EP_RX_EN |= (1 << ep_num); // Enable RX for this endpoint
    ep_set_out_response(ep_num, EP_RESPONSE_NAK);
  } else {
    // Configure IN endpoint for interrupt or bulk transfers
    R32_U2EPn_TX_DMA(ep_num) = (uint32_t)xfer_local->buffer & UEPn_DMA_MASK;
    USBHS_MAX_LEN(ep_num) = 0;
    R8_U2EPn_TX_CTRL(ep_num) = USBHS_UEP_T_TOG_MASK | (0x0 << 0); // Auto-toggle, NAK
    R16_U2EP_TX_EN |= (1 << ep_num); // Enable TX for this endpoint
    ep_set_response_and_toggle(ep_num, dir, EP_RESPONSE_NAK);
  }

  // Small delay to address CH585/CH584 hardware quirk (~1 us at 60 MHz)
  //for (volatile uint32_t i = 0; i < 60; i++) {}
  DelayUs(1);

  printf("Opened endpoint: ep_num=%d, dir=%d, max_size=%d\n", ep_num, dir, xfer_local->max_size);
  return true;
 }
 
