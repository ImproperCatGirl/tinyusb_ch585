 // Set device address (handled via control transfer)
 
 void dcd_set_address(uint8_t rhport, uint8_t dev_addr) {
   (void)rhport;
   
   // Respond with ZLP for Status Stage
   dcd_edpt_xfer(rhport, 0x80, NULL, 0);
   R8_USB2_DEV_AD = dev_addr;
 }
 
